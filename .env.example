# Copy to .env and edit. Real .env is git-ignored.
# Values already set in the process environment take precedence over .env.

# Absolute path to the matching Simutrans `makeobj` binary.
# If unset, the build runs `makeobj` from PATH.
MAKEOBJ_PATH=C:\path\to\simutrans-makeobj.exe

# Optional: absolute path to a Simutrans pakset / addons directory.
# When set (and the directory exists), `build.py` syncs dist/VZ-*.pak there
# after a successful build: prompts before deleting any VZ-*.pak in the
# target that has no match in dist/ (pass -y to skip the prompt), then
# copies the freshly built paks over. Pass --no-install to skip this step.
# PAK_TARGET_DIR=D:\OneDrive\Games\Simutrans\pak128.cs

# Absolute path to the fork's makeobj (simutrans-122.0 with PR #4). Sets with
# `makeobj: fork` (signal-rail/signals: is_platformsignal, station_boundary)
# are built with it; the stock makeobj silently drops those keys.
# MAKEOBJ_FORK_PATH=C:\path\to\simutrans-122.0\build\default\makeobj\makeobj.exe
